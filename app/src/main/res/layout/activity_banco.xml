<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BancoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10sp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usuario:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="10sp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Numero de Cuenta"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingTop="15sp"
            android:paddingBottom="10sp"
            android:inputType="number"
            android:id="@+id/txtNumeroCuenta"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del Cliente"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingTop="15sp"
            android:paddingBottom="10sp"
            android:inputType="text"
            android:id="@+id/txtNombreCliente"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Banco"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingTop="15sp"
            android:paddingBottom="10sp"
            android:inputType="text"
            android:id="@+id/txtBanco"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Saldo"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingTop="15sp"
            android:paddingBottom="10sp"
            android:inputType="numberDecimal"
            android:id="@+id/txtSaldo"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movimientos"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:paddingTop="20sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="15sp">
            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10sp"
                android:id="@+id/rdgMovimientos"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deposito"
                    android:checked="true"
                    android:id="@+id/rdbDeposito"
                    android:padding="5sp"/>

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Retiro"
                    android:id="@+id/rdbRetiro"
                    android:padding="5sp"/>

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consultar Saldo"
                    android:id="@+id/rdbConsSaldo"
                    android:padding="5sp"/>
            </RadioGroup>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nuevo Saldo $"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="10sp"
            android:paddingBottom="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cantidad:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="10sp"
            android:paddingBottom="10sp" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Escribe la cantidad"
            android:textSize="15sp"
            android:textStyle="bold"
            android:inputType="numberDecimal"
            android:id="@+id/txtCantidad"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"></Space>

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registrar Cliente"
                android:id="@+id/btnRegistrar"/>

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aplicar Movimiento"
                android:id="@+id/btnMovimiento"/>

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/strcerrar"
                android:id="@+id/btnCerrar"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>