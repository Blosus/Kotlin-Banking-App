    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10sp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/titulo" android:paddingBottom="10sp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/alumno" android:textColor="@color/white" android:textSize="20sp" android:paddingLeft="10sp" android:paddingTop="10sp" android:id="@+id/lblNombre"> </TextView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/matricula" android:textColor="@color/white" android:textSize="15sp" android:paddingLeft="10sp" android:paddingTop="5sp" android:layout_below="@+id/lblNombre" android:id="@+id/lblMatricula"> </TextView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/materia" android:textColor="@color/white" android:textSize="15sp" android:paddingLeft="10sp" android:paddingTop="5sp" android:layout_below="@+id/lblMatricula" android:id="@+id/lblMateria"> </TextView>
            <ImageView android:layout_width="80dp" android:layout_height="80dp" android:layout_alignParentRight="true" android:layout_marginRight="11sp" android:layout_marginTop="11sp" android:src="@mipmap/yo"> </ImageView>
        </RelativeLayout>
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="4" android:alignmentMode="alignMargins" android:columnOrderPreserved="false">
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardHola">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/hola"> </ImageView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10sp" android:textColor="@color/aceptar" android:text="@string/hola"> </TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardIMC">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
