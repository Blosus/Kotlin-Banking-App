                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardGrados">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/conversion"> </ImageView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10sp" android:textColor="@color/aceptar" android:text="@string/gradCon"> </TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardDivisa">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/moneda"> </ImageView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10sp" android:textColor="@color/aceptar" android:text="@string/dineroConv"> </TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardToyota">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/cotizacion"> </ImageView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10sp" android:textColor="@color/aceptar" android:text="@string/cotizar"> </TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardSpinner">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/spinner"> </ImageView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10sp" android:textColor="@color/aceptar" android:text="@string/spinner"> </TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardPreEx1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/pre1"> </ImageView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10sp" android:textColor="@color/aceptar" android:text="@string/preExamen1"> </TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardPreEx2">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/pre2"> </ImageView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10sp" android:textColor="@color/aceptar" android:text="@string/preExamen2"> </TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardExamen1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/pre1"> </ImageView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10sp" android:textColor="@color/aceptar" android:text="@string/Examen1"> </TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_rowWeight="1" app:cardElevation="6sp" app:cardCornerRadius="12sp" android:layout_margin="12dp" android:id="@+id/cardSalir">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16sp">
                    <ImageView android:layout_width="80dp" android:layout_height="80dp" android:src="@mipmap/salir"> </ImageView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginBottom="10sp" android:textColor="@color/aceptar" android:text="@string/Salir"> </TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>
    </LinearLayout>
</ScrollView>